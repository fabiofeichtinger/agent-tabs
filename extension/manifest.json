{
  "manifest_version": 3,
  "name": "agent-tabs",
  "version": "0.1.0",
  "description": "Lets local AI agents and a CLI list, group, move, open and close tabs via native messaging.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "nativeMessaging"],
  "background": { "service_worker": "background.js" }
}
